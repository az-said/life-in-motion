{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "redirects": [
    {
      "source": "/:path([cC][vV])",
      "destination": "/Said-Azaizah-CV.pdf",
      "statusCode": 307
    },
    {
      "source": "/:path([rR][eE][sS][uU][mM][eE])",
      "destination": "/Said-Azaizah-CV.pdf",
      "statusCode": 307
    },
    {
      "source": "/cv-full",
      "destination": "/Said-Azaizah-CV-Full.pdf",
      "statusCode": 307
    },
    {
      "source": "/cvfull",
      "destination": "/Said-Azaizah-CV-Full.pdf",
      "statusCode": 307
    }
  ],

  "headers": [
    {
      "source": "/Said-Azaizah-CV.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Said-Azaizah-CV.pdf\""
        }
      ]
    },
    {
      "source": "/Said-Azaizah-CV-Full.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Said-Azaizah-CV-Full.pdf\""
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/said.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],

  "rewrites": [{ "source": "/(.*)", "destination": "/" }]
}
